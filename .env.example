# ----------------------------------------------------------------------------
# Life Control Center settings
#
# 1. Make a copy of this file named exactly:  .env
# 2. Paste your Anthropic API key after the = sign below (no quotes, no spaces).
#
# The real .env file is listed in .gitignore, so it will never be uploaded
# to GitHub. Never put your real key in THIS file (.env.example).
# ----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key-goes-here

# Which Claude model each AI feature uses is chosen in the app:
# Settings → AI models.

# Optional: where your data is stored (a single file on your computer).
DATABASE_PATH=data/life.db
