# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

# ---------------------------------------------------------------------------
# Life Control Center
# ---------------------------------------------------------------------------
# Secrets: your real API key lives here. NEVER commit it.
.env

# Personal data: the SQLite database with your goals and tasks.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# The desktop app window's browser settings, and the launcher's log
data/browser-profile/
data/app.log
data/version.json

# Google Calendar connection (your OAuth client and access token)
data/google_*.json

# Python clutter
__pycache__/
*.pyc
.venv/
venv/

# SimpleFIN access link (read-only bank access) and the reminder check's log
data/simplefin.json
data/notifier.log
